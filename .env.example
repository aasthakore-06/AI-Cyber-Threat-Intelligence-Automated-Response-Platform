# copy to .env
ENVIRONMENT=development

# PostgreSQL in docker; for quick local runs use the sqlite line instead
DATABASE_URL=postgresql://postgres:postgres@db:5432/cyber_threat_platform
# DATABASE_URL=sqlite:///./cyber_threat_platform.db

SECRET_KEY=change-this-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# login module: more than 5 failed logins inside 120 s = brute force
LOGIN_FAILED_THRESHOLD=5
LOGIN_WINDOW_SECONDS=120
LOGIN_RATIO_WINDOW_DAYS=7
LOGIN_RATIO_THRESHOLD=3.0

PORT_SCAN_PORT_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=60

CORRELATION_WINDOW_SECONDS=1800
DECAY_STEP_HOURS=6
DECAY_PERCENT=10
DECAY_FLOOR_RATIO=0.5
GRAPH_LOOKBACK_HOURS=24

# honeytokens / decoys (comma separated). Copied into the honeytokens table at startup.
HONEYTOKENS=HONEYTOKEN_AWS_DEV_KEY_9921,decoy_admin_token_alpha,svc_backup_decoy,/admin/backup-keys
